{
  "name": "speakingstage-video",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio",
    "audio": "node scripts/make-audio2.mjs",
    "render": "remotion render src/index.ts Speaker out/speakingstage-speaker.mp4 --browser-executable=/opt/pw-browsers/chromium",
    "still": "remotion still src/index.ts Speaker --browser-executable=/opt/pw-browsers/chromium",
    "frames": "bash scripts/extract-frames.sh",
    "record": "cd capture && node record.cjs",
    "render:v2": "remotion render src/index.ts SpeakerV2 out/speakingstage-speaker-v2.mp4 --gl=swangle --codec=h264 --crf=18 --concurrency=3",
    "stills": "node scripts/stills.mjs",
    "render:wide": "remotion render src/index.ts SpeakerV2Wide out/speakingstage-speaker-v2-16x9.mp4 --gl=swangle --codec=h264 --crf=18 --concurrency=3"
  },
  "dependencies": {
    "@react-three/fiber": "^8.17.10",
    "@remotion/cli": "^4.0.539",
    "@remotion/fonts": "^4.0.539",
    "@remotion/google-fonts": "^4.0.539",
    "@remotion/media": "^4.0.539",
    "@remotion/media-utils": "^4.0.539",
    "@remotion/motion-blur": "^4.0.539",
    "@remotion/three": "^4.0.539",
    "@remotion/transitions": "^4.0.539",
    "@types/react": "^18.3.31",
    "@types/three": "^0.169.0",
    "mediabunny": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.539",
    "three": "^0.169.0",
    "typescript": "^7.0.2"
  }
}