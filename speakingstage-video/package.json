{
  "name": "speakingstage-video",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio",
    "audio": "node scripts/make-audio2.mjs",
    "render": "remotion render src/index.ts Speaker out/speakingstage-speaker.mp4 --browser-executable=/opt/pw-browsers/chromium",
    "still": "remotion still src/index.ts Speaker --browser-executable=/opt/pw-browsers/chromium",
    "frames": "bash scripts/extract-frames.sh",
    "record": "cd capture && node record.cjs",
    "render:v2": "remotion render src/index.ts SpeakerV2 out/speakingstage-speaker-v2.mp4 --gl=swangle --codec=h264 --crf=18 --concurrency=3",
    "stills": "node scripts/stills.mjs",
    "render:wide": "remotion render src/index.ts SpeakerV2Wide out/speakingstage-speaker-v2-16x9.mp4 --gl=swangle --codec=h264 --crf=18 --concurrency=3",
    "vo": "node scripts/make-vo.mjs",
    "vo:placeholder": "node scripts/make-vo.mjs --placeholder",
    "audio:vo": "node scripts/make-audio2.mjs --vo",
    "render:vo": "remotion render src/index.ts SpeakerV2VO out/speakingstage-speaker-v2-vo.mp4 --gl=swangle --codec=h264 --crf=18 --concurrency=3",
    "render:vo-wide": "remotion render src/index.ts SpeakerV2VOWide out/speakingstage-speaker-v2-vo-16x9.mp4 --gl=swangle --codec=h264 --crf=18 --concurrency=3",
    "record:profile": "cd capture && node record-profile.cjs",
    "audio:showreel": "node scripts/make-audio-showreel.mjs",
    "render:showreel": "remotion render src/index.ts ShowreelChris out/showreel-chris-aike-spring-1x1.mp4 --gl=swangle --codec=h264 --crf=18 --concurrency=3",
    "vo:showreel": "node scripts/make-vo.mjs --script=showreel",
    "audio:showreel-vo": "node scripts/make-audio-showreel.mjs --vo",
    "render:showreel-vo": "remotion render src/index.ts ShowreelChrisVO out/showreel-chris-aike-spring-1x1-vo.mp4 --gl=swangle --codec=h264 --crf=18 --concurrency=3",
    "vo:pitch": "node scripts/make-vo.mjs --script=pitch",
    "audio:pitch": "node scripts/make-audio-pitch.mjs",
    "vo:apple": "node scripts/make-vo.mjs --script=apple",
    "audio:apple": "node scripts/make-audio-apple.mjs",
    "render:apple": "remotion render src/index.ts AppleChris out/apple-chris-raw.mp4 --gl=swangle --codec=h264 --crf=16 --scale=1.5 --concurrency=3 && ffmpeg -y -i out/apple-chris-raw.mp4 -vf scale=1080:1080:flags=lanczos -c:v libx264 -crf 17 -pix_fmt yuv420p -c:a copy out/apple-chris-aike-spring-1x1.mp4",
    "vo:ad": "node scripts/make-vo.mjs --script=ad",
    "audio:ad": "node scripts/make-audio-ad.mjs",
    "record:ad": "cd capture && node record-ad.cjs",
    "render:ad": "remotion render src/index.ts SpeakingStageAd out/ad-raw.mp4 --gl=swangle --codec=h264 --crf=16 --scale=1 --concurrency=4 && ffmpeg -y -i out/ad-raw.mp4 -vf scale=1080:1080:flags=lanczos -c:v libx264 -crf 17 -pix_fmt yuv420p -c:a copy out/speakingstage-ad-linkedin-1x1.mp4",
    "render:pitch": "remotion render src/index.ts PitchChris out/pitch-chris-raw.mp4 --gl=swangle --codec=h264 --crf=16 --scale=1.5 --concurrency=3 && ffmpeg -y -i out/pitch-chris-raw.mp4 -vf scale=1080:1080:flags=lanczos -c:v libx264 -crf 17 -pix_fmt yuv420p -c:a copy out/pitch-chris-aike-spring-1x1.mp4"
  },
  "dependencies": {
    "@react-three/fiber": "^8.17.10",
    "@remotion/cli": "^4.0.539",
    "@remotion/fonts": "^4.0.539",
    "@remotion/google-fonts": "^4.0.539",
    "@remotion/media": "^4.0.539",
    "@remotion/media-utils": "^4.0.539",
    "@remotion/motion-blur": "^4.0.539",
    "@remotion/three": "^4.0.539",
    "@remotion/transitions": "^4.0.539",
    "@types/react": "^18.3.31",
    "@types/three": "^0.169.0",
    "mediabunny": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.539",
    "three": "^0.169.0",
    "typescript": "^7.0.2"
  }
}